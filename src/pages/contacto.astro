---
import Layout from '../layouts/Layout.astro';
const site = (await import('../data/site.json')).default;
const contenido = (await import('../data/paginas/contacto.json')).default;
---

<Layout title="Contacto" description={contenido.instrucciones}>
  <article>
    <header class="mb-10 md:mb-12">
      <h1 class="text-3xl font-semibold tracking-tight text-natural-800 md:text-4xl">
        {contenido.titulo}
      </h1>
      <p class="mt-3 text-lg text-natural-600">{contenido.subtitulo}</p>
      <p class="mt-4 max-w-2xl text-[var(--color-earth)]/90 leading-relaxed">
        {contenido.instrucciones}
      </p>
    </header>

    <section class="grid gap-6 md:grid-cols-2">
      {contenido.telefonos.map((telefono) => (
        <a
          href={telefono.url}
          target={telefono.url.startsWith('http') ? '_blank' : undefined}
          rel={telefono.url.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="rounded-2xl bg-white/80 p-6 ring-1 ring-natural-200/60 transition-shadow hover:shadow-md"
        >
          <span class="text-sm font-semibold uppercase tracking-wide text-[var(--color-earth)]/80">
            {telefono.tipo}
          </span>
          <strong class="mt-2 block text-2xl text-natural-800">{telefono.texto}</strong>
        </a>
      ))}
    </section>

    <section class="mt-8 rounded-2xl bg-white/80 p-8 ring-1 ring-natural-200/60">
      <h2 class="text-xl font-semibold text-natural-800">Redes sociales</h2>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={contenido.facebook.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-[#1877F2] px-6 py-3 font-medium text-white transition-colors hover:bg-[#166FE5]"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
          {contenido.facebook.boton}
        </a>
        <a
          href={contenido.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full bg-natural-700 px-6 py-3 font-medium text-white transition-colors hover:bg-natural-800"
        >
          {contenido.instagram.boton}
        </a>
      </div>
    </section>

    <section class="mt-8 rounded-2xl bg-natural-100/70 p-6">
      <h2 class="text-xl font-semibold text-natural-800">Ubicación</h2>
      <p class="mt-2 font-medium text-natural-700">{contenido.ubicacion.nombre}</p>
      <p class="mt-1 text-[var(--color-earth)]/90">{contenido.ubicacion.texto}</p>
      <h2 class="mt-6 text-xl font-semibold text-natural-800">{contenido.horario.titulo}</h2>
      <p class="mt-2 text-[var(--color-earth)]/90">{contenido.horario.texto}</p>
    </section>

    <p class="mt-6 text-sm text-[var(--color-warm-stone)]">{contenido.formularioNota}</p>
  </article>
</Layout>
