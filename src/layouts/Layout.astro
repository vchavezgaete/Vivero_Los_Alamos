---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const site = (await import('../data/site.json')).default;
const pageDescription = description ?? site.descripcionCorta;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {site.nombre}</title>
  </head>
  <body class="min-h-screen bg-[var(--color-cream)] text-[var(--color-earth)] antialiased">
    <header class="sticky top-0 z-50 border-b border-natural-200/60 bg-[var(--color-cream)]/95 backdrop-blur-sm">
      <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-6">
        <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-90">
          <img
            src={site.logo}
            alt={site.nombre}
            class="h-12 w-12 rounded-xl object-contain shadow-sm md:h-14 md:w-14"
            width="56"
            height="56"
          />
          <span class="text-lg font-semibold text-natural-800 md:text-xl">{site.nombre}</span>
        </a>
        <ul class="flex flex-wrap items-center gap-5 text-sm font-medium">
          <li><a href="/" class="text-warm-stone transition-colors hover:text-natural-600">Inicio</a></li>
          <li><a href="/nosotros" class="text-warm-stone transition-colors hover:text-natural-600">Nosotros</a></li>
          <li><a href="/productos" class="text-warm-stone transition-colors hover:text-natural-600">Productos</a></li>
          <li><a href="/contacto" class="text-warm-stone transition-colors hover:text-natural-600">Contacto</a></li>
          <li><a href="/admin" class="text-stone-400 transition-colors hover:text-warm-stone">Admin</a></li>
          {site.facebook && (
            <li>
              <a
                href={site.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full bg-natural-600 px-4 py-2 text-white transition-colors hover:bg-natural-700"
              >
                Facebook
              </a>
            </li>
          )}
          {site.instagram && (
            <li>
              <a
                href={site.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-natural-300 px-4 py-2 text-natural-700 transition-colors hover:border-natural-500 hover:text-natural-800"
              >
                Instagram
              </a>
            </li>
          )}
        </ul>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8 md:px-6">
      <slot />
    </main>

    <footer class="mt-auto border-t border-natural-200/60 bg-natural-50/50 py-10">
      <div class="mx-auto max-w-6xl px-4 text-center md:px-6">
        <img src={site.logo} alt="" class="mx-auto h-10 w-10 rounded-lg object-contain opacity-80" width="40" height="40" />
        <p class="mt-3 font-medium text-natural-800">{site.nombre} · Nueva Imperial</p>
        {(site.facebook || site.instagram) && (
          <div class="mt-2 flex flex-wrap justify-center gap-4">
            {site.facebook && (
              <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="text-natural-600 transition-colors hover:text-natural-700">Síguenos en Facebook</a>
            )}
            {site.instagram && (
              <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="text-natural-600 transition-colors hover:text-natural-700">Síguenos en Instagram</a>
            )}
          </div>
        )}
      </div>
    </footer>
  </body>
</html>
