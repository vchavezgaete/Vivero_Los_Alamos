---
import Layout from '../layouts/Layout.astro';
const site = (await import('../data/site.json')).default;
const contenido = (await import('../data/paginas/inicio.json')).default;
const heroImage = contenido.hero.imagenFondo;
---

<Layout title="Inicio" description={site.descripcionCorta}>
  <article>
    <!-- Hero: la foto del vivero como protagonista, overlay suave solo donde va el texto -->
    <section class="relative -mx-4 overflow-hidden rounded-2xl md:-mx-6 md:rounded-3xl">
      <div class="aspect-[16/10] min-h-[280px] md:aspect-[21/9] md:min-h-[360px]">
        <img
          src={heroImage}
          alt="Vivero Los Álamos"
          class="h-full w-full object-cover"
          fetchpriority="high"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"
          aria-hidden="true"
        />
      </div>
      <div class="absolute bottom-0 left-0 right-0 p-6 text-white md:p-10">
        <h1 class="text-3xl font-semibold tracking-tight drop-shadow-sm md:text-4xl lg:text-5xl">
          {contenido.hero.titulo}
        </h1>
        <p class="mt-2 max-w-xl text-lg text-white/95 drop-shadow-sm md:text-xl">
          {contenido.hero.subtitulo}
        </p>
        <a
          href="/productos"
          class="mt-6 inline-block rounded-full bg-white/95 px-6 py-2.5 font-medium text-natural-800 transition-colors hover:bg-white"
        >
          {contenido.hero.cta}
        </a>
      </div>
    </section>

    <!-- Por qué elegirnos: tarjetas suaves, mucho aire -->
    <section class="mt-16 md:mt-20">
      <h2 class="text-2xl font-semibold text-natural-800 md:text-3xl">
        {contenido.destacado.titulo}
      </h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {contenido.destacado.items.map((item) => (
          <div class="rounded-2xl bg-white/80 p-6 shadow-none ring-1 ring-natural-200/60 backdrop-blur-sm transition-shadow hover:shadow-md">
            <h3 class="font-semibold text-natural-700">{item.titulo}</h3>
            <p class="mt-3 text-[var(--color-earth)]/90 leading-relaxed">{item.texto}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Llamado a la acción: bloque calmado -->
    <section class="mt-16 rounded-2xl bg-natural-100/70 p-8 text-center md:mt-20 md:p-12">
      <h2 class="text-xl font-semibold text-natural-800 md:text-2xl">
        {contenido.llamadoAccion.titulo}
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-natural-700/90">
        {contenido.llamadoAccion.texto}
      </p>
      <a
        href="/contacto"
        class="mt-6 inline-block rounded-full bg-natural-600 px-6 py-2.5 font-medium text-white transition-colors hover:bg-natural-700"
      >
        {contenido.llamadoAccion.boton}
      </a>
    </section>
  </article>
</Layout>
