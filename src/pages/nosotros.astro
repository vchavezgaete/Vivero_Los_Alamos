---
import Layout from '../layouts/Layout.astro';
const contenido = (await import('../data/paginas/nosotros.json')).default;
---

<Layout title="Nosotros" description={contenido.contenido.slice(0, 160)}>
  <article>
    <header class="mb-10 md:mb-12">
      <h1 class="text-3xl font-semibold tracking-tight text-natural-800 md:text-4xl">
        {contenido.titulo}
      </h1>
      <p class="mt-3 text-lg text-natural-600">{contenido.subtitulo}</p>
    </header>

    <div class="space-y-5 text-[var(--color-earth)]/90 leading-relaxed">
      {contenido.contenido.split('\n\n').map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-natural-800">Nuestros valores</h2>
      <ul class="mt-6 grid gap-5 sm:grid-cols-3">
        {contenido.valores.map((v) => (
          <li class="rounded-2xl bg-white/80 p-6 ring-1 ring-natural-200/60">
            <span class="font-semibold text-natural-700">{v.titulo}</span>
            <p class="mt-2 text-sm text-[var(--color-earth)]/80">{v.texto}</p>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Layout>
