---
import Layout from '../layouts/Layout.astro';
const contenido = (await import('../data/paginas/productos.json')).default;
---

<Layout title="Productos" description={contenido.intro}>
  <article>
    <header class="mb-10 md:mb-12">
      <h1 class="text-3xl font-semibold tracking-tight text-natural-800 md:text-4xl">
        {contenido.titulo}
      </h1>
      <p class="mt-3 text-lg text-natural-600">{contenido.subtitulo}</p>
      <p class="mt-4 max-w-2xl text-[var(--color-earth)]/90 leading-relaxed">
        {contenido.intro}
      </p>
    </header>

    <ul class="grid gap-6 sm:grid-cols-2">
      {contenido.categorias.map((cat) => (
        <li class="rounded-2xl bg-white/80 p-6 ring-1 ring-natural-200/60 transition-shadow hover:shadow-md">
          <h2 class="text-lg font-semibold text-natural-700">{cat.nombre}</h2>
          <p class="mt-3 text-[var(--color-earth)]/90">{cat.descripcion}</p>
        </li>
      ))}
    </ul>

    <section class="mt-12" aria-labelledby="precios-2026">
      <div class="mb-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-earth)]/80">
          Listado de precios 2026
        </p>
        <h2 id="precios-2026" class="mt-2 text-2xl font-semibold text-natural-800">
          Plantas nativas, ornamentales, forestales y otros
        </h2>
      </div>

      <div class="grid gap-6 lg:grid-cols-[1.35fr_0.9fr]">
        {contenido.precios.map((grupo) => (
          <article class="overflow-hidden rounded-2xl bg-white/85 ring-1 ring-natural-200/70">
            <h3 class="bg-natural-700 px-5 py-4 text-lg font-semibold text-white">
              {grupo.grupo}
            </h3>
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-left text-sm">
                <thead class="bg-natural-100 text-xs uppercase tracking-wide text-natural-800">
                  <tr>
                    <th class="px-4 py-3 font-semibold">Producto</th>
                    <th class="px-4 py-3 font-semibold">Formato</th>
                    <th class="px-4 py-3 text-right font-semibold">Precio</th>
                  </tr>
                </thead>
                <tbody>
                  {grupo.items.map((item) => (
                    <tr class="border-t border-natural-200/70">
                      <td class="px-4 py-3 font-medium text-natural-800">{item.producto}</td>
                      <td class="px-4 py-3 text-[var(--color-earth)]/90">{item.formato}</td>
                      <td class="whitespace-nowrap px-4 py-3 text-right font-semibold text-natural-800">{item.precio}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </article>
        ))}
      </div>
    </section>

    <p class="mt-10 rounded-2xl bg-natural-100/70 p-5 text-natural-700">
      {contenido.nota}
    </p>
  </article>
</Layout>
